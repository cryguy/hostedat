---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Self-hosted static site hosting. Deploy in one command.' } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} — hostedat</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class="bg-zinc-950 text-zinc-300 antialiased selection:bg-emerald-500/20 selection:text-emerald-200">
  <div class="noise"></div>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  :root {
    --accent: #34d399;
    --accent-dim: #065f46;
    --surface-0: #09090b;
    --surface-1: #18181b;
    --surface-2: #27272a;
    --border: #3f3f46;
    --text-primary: #f4f4f5;
    --text-secondary: #a1a1aa;
    --text-muted: #71717a;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scrollbar-color: var(--surface-2) transparent;
  }

  body {
    font-family: 'DM Sans', system-ui, sans-serif;
    line-height: 1.7;
    position: relative;
    min-height: 100vh;
  }

  code, pre, .font-mono {
    font-family: 'DM Mono', 'Consolas', monospace;
  }

  .noise {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 256px 256px;
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: var(--surface-2);
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--border);
  }

  /* Focus styles */
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Prose-like defaults for doc pages */
  .prose h1 {
    @apply text-3xl font-bold text-zinc-100 mb-4 mt-12 first:mt-0;
    letter-spacing: -0.025em;
  }
  .prose h2 {
    @apply text-xl font-semibold text-zinc-100 mb-3 mt-10;
    letter-spacing: -0.015em;
  }
  .prose h3 {
    @apply text-lg font-medium text-zinc-200 mb-2 mt-8;
  }
  .prose p {
    @apply mb-4 text-zinc-400 leading-relaxed;
  }
  .prose a {
    @apply text-emerald-400 hover:text-emerald-300 underline underline-offset-2 decoration-emerald-400/30 hover:decoration-emerald-300/60 transition-colors;
  }
  .prose ul {
    @apply mb-4 pl-5 space-y-1.5;
  }
  .prose li {
    @apply text-zinc-400 relative;
  }
  .prose ul li::marker {
    @apply text-zinc-600;
  }
  .prose strong {
    @apply text-zinc-200 font-medium;
  }
  .prose code:not(pre code) {
    @apply text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded text-sm border border-emerald-500/10;
  }
  .prose hr {
    @apply border-zinc-800 my-8;
  }
  .prose table {
    @apply w-full mb-6 text-sm;
  }
  .prose th {
    @apply text-left text-zinc-400 font-medium px-3 py-2 border-b border-zinc-800;
  }
  .prose td {
    @apply px-3 py-2 text-zinc-400 border-b border-zinc-800/50;
  }
  .prose blockquote {
    @apply border-l-2 border-emerald-500/40 pl-4 my-4 text-zinc-500 italic;
  }
</style>
