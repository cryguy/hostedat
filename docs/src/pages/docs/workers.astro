        <td><code>/worker/env/:varId</code></td>
        <td>Delete environment variable</td>
      </tr>
      <tr>
        <td><code>POST</code></td>
        <td><code>/worker/kv</code></td>
        <td>Create KV namespace</td>
      </tr>
      <tr>
        <td><code>GET</code></td>
        <td><code>/worker/kv</code></td>
        <td>List KV namespaces</td>
      </tr>
      <tr>
        <td><code>DELETE</code></td>
